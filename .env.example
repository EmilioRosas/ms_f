# Copia este archivo a .env.local si necesitas cambiar algún valor.
VITE_AUTH_SERVER_URL=http://localhost:9000
VITE_CLIENT_ID=frontend-client
VITE_REDIRECT_URI=http://localhost:3000/callback
VITE_POST_LOGOUT_URI=http://localhost:3000/login
VITE_SCOPES=openid profile read write

# Rutas relativas: pasan por el proxy de Vite (vite.config.ts).
# /oauth2/token va al server (:9000); /api/* va al API Gateway (:8080).
VITE_TOKEN_ENDPOINT=/oauth2/token
VITE_MSA_BASE=/api/entity-a
VITE_MSB_BASE=/api/b
VITE_ALUMNOS_BASE=/api/alumno

# URLs directas, solo para el indicador de estado del login
VITE_GATEWAY_URL=http://localhost:8080
VITE_MSA_URL=http://localhost:8081
VITE_MSB_URL=http://localhost:8082
VITE_ALUMNOS_URL=http://localhost:8083
